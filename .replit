modules = ["python-base-3.13", "nodejs-24", "postgresql-16"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "blog"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "blog"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 scripts/validate-blog.py"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "DISABLE_BACKGROUND_JOBS=true PORT=5000 npm start"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[deployment]
deploymentTarget = "autoscale"
run = ["npm", "start"]

[[ports]]
localPort = 4178
externalPort = 3000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8000
externalPort = 8000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.production]
SF13_SEQUENCE_ENABLED = "true"

[userenv.shared]
DEMO_REBUILD_UNLIMITED_KEY_IDS = "a508a32f-ea0b-4969-8f1c-f07d44656b5b,38b9d45b-3489-4750-baa8-2f400b8074df"
